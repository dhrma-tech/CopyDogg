# Add ONE key. Leave both empty to try CopyDogg in demo mode (placeholder posts, no API calls).

# Claude — https://platform.claude.com/settings/keys (paid API credit)
ANTHROPIC_API_KEY=

# Gemini — https://aistudio.google.com/apikey (has a free tier)
GEMINI_API_KEY=

# Optional. With both keys set, Claude is used. Set "gemini" to use Gemini instead.
AI_PROVIDER=

# Optional. Gemini model to use. Defaults to gemini-flash-latest.
GEMINI_MODEL=

# Optional. Set this only if your copy is reachable by other people (a VPS,
# your home network, a tunnel). Everyone then needs this password once per device.
COPYDOGG_PASSWORD=

# Optional. Where your data file lives. Defaults to ./data in the project folder.
COPYDOGG_DATA_DIR=
