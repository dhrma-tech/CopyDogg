# Your Claude API key — https://platform.claude.com/settings/keys
# Leave empty to try CopyDogg in demo mode (placeholder posts, no API calls).
ANTHROPIC_API_KEY=

# Optional. Set this only if your copy is reachable by other people (a VPS,
# your home network, a tunnel). Everyone then needs this password once per device.
COPYDOGG_PASSWORD=

# Optional. Where your data file lives. Defaults to ./data in the project folder.
COPYDOGG_DATA_DIR=
