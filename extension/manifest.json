{
  "manifest_version": 3,
  "name": "CopyDogg",
  "version": "1.1.0",
  "description": "Opens your local CopyDogg app in the side panel, next to whatever you're posting on. Requires CopyDogg to already be running (npm run dev).",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open CopyDogg",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-copydogg": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Open CopyDogg in the side panel"
    },
    "open-copydogg-window": {
      "description": "Open CopyDogg in its own window"
    }
  },
  "permissions": ["tabs", "sidePanel"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"]
}
